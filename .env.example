# Réglages de installer.py (copier en .env, ne jamais publier le .env).
# n8n : adresse vue depuis votre poste, compte qui possède les workflows du module 1 (un compte membre suffit).
N8N_URL=http://n8n.localhost:8080
N8N_EMAIL=
N8N_MOT_DE_PASSE=
# Open WebUI : adresse vue depuis votre poste, et jeton d'un compte administrateur (Réglages › Compte › Clés d'API).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Adresse d'Open WebUI vue depuis le conteneur n8n : le service Kubernetes, jamais localhost.
OWUI_INTERNE=http://open-webui.terminals.svc.cluster.local:8080
# Adresse e-mail du compte Open WebUI du manager, qui recevra les demandes dans le canal.
MANAGER_EMAIL=
